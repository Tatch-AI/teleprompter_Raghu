# Copy to .env.local (git-ignored) and fill in. Everything is optional for the
# scripted demo; both keys are required for the real-time "live call" experience.

# --- LLM extraction (structured field extraction from transcript chunks) ---
# Without this, the app falls back to the deterministic mock extractor.
OPENAI_API_KEY=
# Optional model override (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Also used by `npm run synthesize-demo-audio` (OpenAI TTS) to generate the
# two-voice demo call audio in public/demo-audio/. Optional model override
# (defaults to tts-1):
# OPENAI_TTS_MODEL=tts-1

# --- Deepgram (live mic + audio-file streaming transcription) ---
# Without this, "Go live (mic)", "Stream recording", and "Play synthesized
# call" are disabled. The browser never sees this key: /api/deepgram-token
# mints a short-lived token.
DEEPGRAM_API_KEY=
# Only needed as a fallback if the SDK cannot mint an ephemeral grant token.
# DEEPGRAM_PROJECT_ID=
